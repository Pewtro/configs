{
  "name": "@putstack/root",
  "version": "1.0.0",
  "private": true,
  "description": "Root package for @putstack/* configuration packages that are also generally released standalone",
  "license": "MIT",
  "author": "Putro",
  "repository": "https://github.com/Pewtro/configs",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "lint:fix": "pnpm lint --fix",
    "lint": "oxlint --format stylish --max-warnings 0",
    "lint:eslint": "eslint --format stylish --max-warnings 0",
    "prepare": "lefthook install",
    "release": "changeset publish",
    "stylecheck": "prettier --check . && pnpm oxfmt --check",
    "test:ci": "npm-run-all -p -l \"lint .\" \"lint:eslint .\" typecheck stylecheck test",
    "test:coverage": "pnpm run test --coverage",
    "test:ui": "vitest --ui --coverage",
    "test:watch": "vitest watch",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@changesets/cli": "3.0.3",
    "@putstack/eslint-config-typescript": "workspace:*",
    "@putstack/oxfmt-config": "workspace:*",
    "@putstack/oxlint-config": "workspace:*",
    "@putstack/prettier-config": "workspace:*",
    "@types/node": "26.6.3",
    "@vitest/coverage-v8": "5.0.2",
    "@vitest/ui": "5.0.2",
    "eslint": "10.11.0",
    "lefthook": "2.1.14",
    "npm-run-all2": "9.0.3",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "prettier": "3.9.9",
    "publint": "0.3.24",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  },
  "packageManager": "pnpm@12.8.1"
}
