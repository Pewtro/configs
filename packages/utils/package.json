{
  "name": "@putstack/utils",
  "version": "0.4.6",
  "description": "Various utility functions I find myself recreating over and over again.",
  "keywords": [
    "putro",
    "putstack",
    "utility",
    "utils"
  ],
  "license": "MIT",
  "author": "Putro",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pewtro/configs.git",
    "directory": "packages/utils"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "default": "./dist/*/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:coverage": "pnpm test -- --coverage",
    "test:watch": "vitest watch"
  },
  "dependencies": {},
  "devDependencies": {},
  "peerDependencies": {},
  "engines": {
    "node": "^18.18 || ^20.9 || >=22"
  }
}
